# 빌드 산출물 (Chrome 웹 스토어 제출 패키지)
dist/

# Python 캐시
__pycache__/
*.pyc

# Node / 확장 빌드 산출물
node_modules/
dist-ext/

# Astro 생성 타입
site/.astro/

# ---------------------------------------------------------------------------
# 비밀 정보 — 실수로 커밋하지 않도록 막습니다. 이 저장소는 공개입니다.
# 키·토큰·비밀번호는 코드나 설정 파일에 두지 말고, 환경 변수나 사용자가 직접 입력하게 하세요.
# (공개 저장소에 한 번 올라간 값은 이력에서 지워도 이미 복제됐다고 봐야 하므로, 올라갔다면 즉시 폐기·교체합니다.)
# ---------------------------------------------------------------------------

# 환경 변수 파일 (예시 파일은 허용)
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# 인증서·개인키·키 저장소
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/

# 자격 증명 파일
.npmrc
.netrc
.pypirc
.aws/
.azure/
.config/gcloud/
credentials
credentials.*
*-credentials.json
service-account*.json
secrets/
secrets.*
*.secret
*.secrets

# 로컬 전용 설정·상태
.claude/settings.local.json
local.settings.json
*.tfvars
*.tfstate
*.tfstate.*

