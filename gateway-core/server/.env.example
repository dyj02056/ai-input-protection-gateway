# PDP 서버 설정 예시입니다. 실제 값은 `.env`(커밋되지 않음)나 환경 변수로 넣으세요.
# 이 저장소는 공개입니다. 이 파일에는 절대 실제 키를 적지 마세요.

# 키는 `py tools/server.py newkey --name 조직이름`으로 만듭니다.
# 평문 키 대신 해시만 서버에 두는 것을 권합니다. (이름=SHA-256 16진수 64자)
PDP_API_KEYS_SHA256=

# 또는 평문 키(최소 24자). 이름=키 를 쉼표로 이어서 적습니다.
PDP_API_KEYS=

# 로컬 개발 전용: 1이면 인증 없이 시작합니다. 127.0.0.1에서만 쓰세요.
# PDP_ALLOW_NO_AUTH=1

# 정책 파일 폴더(기본: server/policy_files)와 활성 버전(기본: 가장 높은 버전)
# PDP_POLICY_DIR=
# PDP_ACTIVE_POLICY_VERSION=

# 요청 본문 크기 상한(바이트). 범주 ID만 받으므로 작게 유지합니다.
# PDP_MAX_BODY_BYTES=4096
