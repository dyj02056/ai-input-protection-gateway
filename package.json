{
  "name": "ai-input-protection-gateway-extension",
  "version": "1.6.0",
  "private": true,
  "description": "AI 입력정보 보호 게이트웨이 브라우저 확장 — 빌드·테스트 도구 (제출 ZIP에는 dist-ext/만 들어갑니다)",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:docs": "astro build --root site",
    "dev:docs": "astro dev --root site",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
