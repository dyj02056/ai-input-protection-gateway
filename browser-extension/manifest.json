{
  "manifest_version": 3,
  "name": "AI 입력정보 보호 게이트웨이",
  "version": "1.6.0",
  "description": "ChatGPT·Claude·Gemini에 보내기 전 개인정보를 검사하고 마스킹하는 로컬 보호 확장 (기본 설정에서는 서버 전송 없음)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI 입력정보 보호",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["detector.js", "policy.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}